# Project Atlas environment template.
#
#   cp .env.example .env
#
# IMPORTANT: a blank value is NOT the same as "use the default". Pydantic parses
# "" and fails on any typed field, so only variables that are safe to leave
# empty (optional secrets) appear blank below. Every tuning knob is omitted on
# purpose and falls back to the value in app/config.py; add one back only when
# you intend to override it, and always with a real value.
#
# Never commit .env - it is gitignored.

# --- LLM provider (required for answer generation) -------------------------
# Key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Datastores (required) -------------------------------------------------
# Port 55432 matches docker-compose.yml, which avoids clashing with a local
# PostgreSQL already on 5432. Must be the async driver (postgresql+asyncpg).
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:55432/atlas
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Frontend / CORS ------------------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- Optional: Supabase-hosted deployment ---------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional: reserved, not yet consumed by the application --------------
JWT_SECRET_KEY=

# --- Local runtime --------------------------------------------------------
ATLAS_ENVIRONMENT=local
ATLAS_LOG_LEVEL=INFO

# --- Frequently overridden settings (uncomment to change) -----------------
# Retrieval backend. "sentence_transformer" (default) is semantic;
# "local_hash" is deterministic, offline and NOT semantic.
# ATLAS_EMBEDDING_BACKEND=sentence_transformer
# ATLAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ATLAS_EMBEDDING_DIMENSIONS=384        # must match the model's width
# ATLAS_INDEX_VERSION=3                 # bump forces reindex of older documents
# ATLAS_QDRANT_COLLECTION=atlas_chunks
# ATLAS_INGESTION_TIMEOUT_SECONDS=300
# ATLAS_MAX_UPLOAD_BYTES=52428800
# ATLAS_UPLOAD_DIR=./uploads
# ATLAS_GRAPH_DIR=./graphs
# ATLAS_AUTO_CREATE_SCHEMA=false        # true only for throwaway local databases

# --- Deployment (set by the platform, e.g. Render) ------------------------
# PORT=8000
# WEB_CONCURRENCY=1
# FORWARDED_ALLOW_IPS=127.0.0.1
